# Hostinger Agency Hosting runtime
APP_ENV=production
APP_URL=https://admin.petlf.com
NEXT_PUBLIC_API_URL=https://admin.petlf.com/api/v1
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=petlf_operations
DB_USERNAME=petlf_operations
DB_PASSWORD=replace-in-hpanel
APP_KEY=replace-with-base64-encoded-32-byte-key
CRON_SECRET=replace-with-at-least-32-random-characters

# WooCommerce
WOOCOMMERCE_URL=https://petlf.com
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://admin.petlf.com/api/v1/integrations/google/callback
GA4_PROPERTY_ID=
SEARCH_CONSOLE_PROPERTY=

# AI gateway (server only)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
AI_DEFAULT_PROVIDER=openai

# Feature flags (future PHP modules)
ENABLE_SEO=true
ENABLE_SOCIAL=false
ENABLE_AI=true
ENABLE_SUPPLIERS=true
ENABLE_AUTOMATION=true
